generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model PairingManualBaseline {
  id          String   @id @default(cuid())
  pairingKey  String   @unique @map("pairing_key")
  extraWinsA  Int      @default(0) @map("extra_wins_a")
  extraWinsB  Int      @default(0) @map("extra_wins_b")
  extraBonusA Int      @default(0) @map("extra_bonus_a")
  extraBonusB Int      @default(0) @map("extra_bonus_b")
  /// true: extraWins = absoluter Zielstand; false: additiv (Legacy)
  isAbsolute  Boolean  @default(false) @map("is_absolute")
  /// App-Siege/Diff zum Korrekturzeitpunkt (nur bei isAbsolute); null = Legacy-Freeze
  appWinsASnap  Int? @map("app_wins_a_snap")
  appWinsBSnap  Int? @map("app_wins_b_snap")
  appBonusASnap Int? @map("app_bonus_a_snap")
  appBonusBSnap Int? @map("app_bonus_b_snap")
  note        String?
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("pairing_manual_baselines")
}

model PlayerNameAlias {
  id            String   @id @default(cuid())
  aliasName     String   @unique @map("alias_name")
  canonicalName String   @map("canonical_name")
  createdAt     DateTime @default(now()) @map("created_at")

  @@map("player_name_aliases")
}

/// Anzeigename an Geräte-playerId. Statistik-Schlüssel bleiben playerId.
model PlayerDisplayName {
  id          String   @id @default(cuid())
  playerId    String   @unique @map("player_id")
  displayName String   @map("display_name")
  nameToken   String   @unique @map("name_token")
  updatedAt   DateTime @updatedAt @map("updated_at")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("player_display_names")
}

model League {
  id         String           @id @default(cuid())
  leagueCode String           @unique @map("league_code")
  createdAt  DateTime         @default(now()) @map("created_at")
  sessions   GameSession[]
  standings  LeagueStanding[]

  @@map("leagues")
}

model LeagueStanding {
  id          String @id @default(cuid())
  leagueId    String @map("league_id")
  league      League @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  playerName  String @map("player_name")
  winPoints   Int    @default(0) @map("win_points")
  bonusPoints Int    @default(0) @map("bonus_points")

  @@unique([leagueId, playerName])
  @@map("league_standings")
}

model GameSession {
  id                String   @id @default(cuid())
  inviteCode        String   @unique @map("invite_code")
  gameCount         Int      @map("game_count")
  maxPlayers        Int      @map("max_players")
  useStrategyRules  Boolean  @default(true) @map("use_strategy_rules")
  showOpponentPool  Boolean  @default(false) @map("show_opponent_pool")
  poolEndgameEnabled    Boolean @default(false) @map("pool_endgame_enabled")
  poolEndgameImproverId String? @map("pool_endgame_improver_id")
  poolEndgameResolved   Boolean @default(false) @map("pool_endgame_resolved")
  // Auto house-rule toggles (set by host when creating session)
  ruleYatzyStreak2  Boolean  @default(true) @map("rule_yatzy_streak_2")
  ruleYatzyTriple   Boolean  @default(true) @map("rule_yatzy_triple")
  ruleUpperRace     Boolean  @default(true) @map("rule_upper_race")
  // Optional: Abzug der Mitspieler dem Erfolgreichen gutschreiben (Default aus)
  ruleYatzyStreak2Credit Boolean @default(false) @map("rule_yatzy_streak_2_credit")
  ruleYatzyTripleCredit  Boolean @default(false) @map("rule_yatzy_triple_credit")
  // M40: Spalten-Pool-Boni (oben/unten/Kombi je +2, nur Erster)
  ruleColumnPoolBonuses Boolean @default(true) @map("rule_column_pool_bonuses")
  // Alle Fünfe Effizienz: bis Wurf 7 = 50, danach −5 je 3 Würfe (Default aus)
  ruleYatzyEfficiency Boolean @default(false) @map("rule_yatzy_efficiency")
  columnPoolUpperCredited Boolean @default(false) @map("column_pool_upper_credited")
  columnPoolLowerCredited Boolean @default(false) @map("column_pool_lower_credited")
  columnPoolComboCredited Boolean @default(false) @map("column_pool_combo_credited")
  // KO-Tie-Break (wenn totalScore unentschieden): 3 Würfe „höhere Augenzahl gewinnt“
  koTieBreakEnabled      Boolean @default(false) @map("ko_tie_break_enabled")
  koTieBreakPending      Boolean @default(false) @map("ko_tie_break_pending")
  koTieBreakPlayerAId    String? @map("ko_tie_break_player_a_id")
  koTieBreakPlayerARolls String? @map("ko_tie_break_player_a_rolls")
  koTieBreakPlayerBId    String? @map("ko_tie_break_player_b_id")
  koTieBreakPlayerBRolls String? @map("ko_tie_break_player_b_rolls")
  koTieBreakWinnerPlayerId String? @map("ko_tie_break_winner_player_id")
  status            String   @default("OPEN")
  leagueId          String   @map("league_id")
  league            League   @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  roundNumber       Int      @default(1) @map("round_number")
  pointsAwarded     Boolean  @default(false) @map("points_awarded")
  includeInPairingStats Boolean @default(true) @map("include_in_pairing_stats")
  createdAt         DateTime @default(now()) @map("created_at")
  players           Player[]
  tournamentMatch   TournamentMatch?

  @@index([pointsAwarded])
  @@map("game_sessions")
}

model Player {
  id          String      @id @default(cuid())
  sessionId   String      @map("session_id")
  session     GameSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  name        String
  orderIndex  Int         @map("order_index")
  secretToken String      @unique @map("secret_token")
  runId       String      @unique @map("run_id")
  run         Run         @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([sessionId, orderIndex])
  @@map("players")
}

model Run {
  id                String   @id @default(cuid())
  soloSecretToken   String?  @unique @map("solo_secret_token")
  gameCount         Int      @map("game_count")
  useStrategyRules  Boolean  @default(true) @map("use_strategy_rules")
  totalScore        Int      @default(0) @map("total_score")
  totalRollsUsed    Int      @default(0) @map("total_rolls_used")
  rollsInPool       Int      @default(0) @map("rolls_in_pool")
  rollSaleFreeFillActive Boolean @default(false) @map("roll_sale_free_fill_active")
  // Pool credit when upper section completed first
  upperRacePoolCredited Boolean @default(false) @map("upper_race_pool_credited")
  // scoredSequence marker of last auto yatzy-streak penalty
  yatzyStreakPenaltyAtSequence Int? @map("yatzy_streak_penalty_at_sequence")
  // scoredSequence marker of last auto 3x yatzy wipe
  yatzyTriplePenaltyAtSequence Int? @map("yatzy_triple_penalty_at_sequence")
  extraYatzyCount   Int      @default(0) @map("extra_yatzy_count")
  nextScoredSequence Int     @default(1) @map("next_scored_sequence")
  status            String   @default("ACTIVE")
  createdAt      DateTime @default(now()) @map("created_at")
  finishedAt     DateTime? @map("finished_at")
  games          Game[]
  player         Player?

  @@index([status])
  @@map("runs")
}

model Game {
  id     String  @id @default(cuid())
  runId  String  @map("run_id")
  index  Int
  score             Int @default(0)
  extraYatzyBonus   Int @default(0) @map("extra_yatzy_bonus")
  extraYatzyDieValues String? @map("extra_yatzy_die_values")
  run               Run @relation(fields: [runId], references: [id], onDelete: Cascade)
  fields Field[]

  @@unique([runId, index])
  @@map("games")
}

model Field {
  id         String  @id @default(cuid())
  gameId     String  @map("game_id")
  fieldType  String  @map("field_type")
  score      Int?
  rollsUsed  Int     @default(0) @map("rolls_used")
  scoredSequence Int? @map("scored_sequence")
  yatzyDieValue  Int? @map("yatzy_die_value")
  game       Game    @relation(fields: [gameId], references: [id], onDelete: Cascade)
  rolls      Roll[]

  @@unique([gameId, fieldType])
  @@map("fields")
}

model Roll {
  id          String @id @default(cuid())
  fieldId     String @map("field_id")
  rollNumber  Int    @map("roll_number")
  diceValues  String @map("dice_values")
  field       Field  @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@unique([fieldId, rollNumber])
  @@map("rolls")
}

/// DiceBudget Tournament (Host-App) — orchestriert Partien, getrennt von GameSession
model Tournament {
  id          String             @id @default(cuid())
  inviteCode  String             @unique @map("invite_code")
  name        String?
  modeKey     String             @default("league") @map("mode_key")
  status      String             @default("OPEN")
  hostToken   String             @map("host_token")
  maxEntries  Int                @default(32) @map("max_entries")
  /// JSON-String (Liga-/Turnier-Einstellungen); SQLite ohne Prisma-Json
  config      String?
  createdAt   DateTime           @default(now()) @map("created_at")
  entries     TournamentEntry[]
  groups      TournamentGroup[]
  rounds      TournamentRound[]
  matches     TournamentMatch[]
  standings   TournamentGroupStanding[]

  @@map("tournaments")
}

model TournamentEntry {
  id           String     @id @default(cuid())
  tournamentId String     @map("tournament_id")
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  displayName  String     @map("display_name")
  playerId     String?    @map("player_id")
  orderIndex   Int        @map("order_index")
  joinedAt     DateTime   @default(now()) @map("joined_at")
  homeMatches  TournamentMatch[] @relation("TournamentMatchHomeEntry")
  awayMatches  TournamentMatch[] @relation("TournamentMatchAwayEntry")
  standings    TournamentGroupStanding[]

  @@index([tournamentId])
  @@map("tournament_entries")
}

model TournamentGroup {
  id           String     @id @default(cuid())
  tournamentId String     @map("tournament_id")
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  name         String
  sortOrder    Int        @map("sort_order")
  createdAt    DateTime   @default(now()) @map("created_at")
  rounds       TournamentRound[]
  matches      TournamentMatch[]
  standings    TournamentGroupStanding[]

  @@unique([tournamentId, sortOrder])
  @@map("tournament_groups")
}

model TournamentGroupStanding {
  id           String          @id @default(cuid())
  tournamentId String          @map("tournament_id")
  tournament   Tournament      @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  groupId      String          @map("group_id")
  group        TournamentGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  entryId      String          @map("entry_id")
  entry        TournamentEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  rank         Int             @default(0)
  matchesPlayed Int            @default(0) @map("matches_played")
  wins         Int             @default(0)
  draws        Float           @default(0)
  losses       Int             @default(0)
  points       Float           @default(0)
  totalScoreDiff Int           @default(0) @map("total_score_diff")
  totalScoreFor  Int           @default(0) @map("total_score_for")
  totalScoreAgainst Int        @default(0) @map("total_score_against")

  @@unique([groupId, entryId])
  @@map("tournament_group_standings")
}

model TournamentRound {
  id           String     @id @default(cuid())
  tournamentId String     @map("tournament_id")
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  groupId      String?    @map("group_id")
  group        TournamentGroup? @relation(fields: [groupId], references: [id], onDelete: Cascade)
  phase        String
  roundIndex   Int        @map("round_index")
  legIndex     Int        @default(1) @map("leg_index")
  title        String
  createdAt    DateTime   @default(now()) @map("created_at")
  matches      TournamentMatch[]

  @@index([tournamentId, phase, roundIndex])
  @@map("tournament_rounds")
}

model TournamentMatch {
  id              String           @id @default(cuid())
  tournamentId    String           @map("tournament_id")
  tournament      Tournament       @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  groupId         String?          @map("group_id")
  group           TournamentGroup? @relation(fields: [groupId], references: [id], onDelete: Cascade)
  roundId         String?          @map("round_id")
  round           TournamentRound? @relation(fields: [roundId], references: [id], onDelete: SetNull)
  phase           String
  bracketSlot     Int?             @map("bracket_slot")
  matchIndex      Int              @map("match_index")
  homeEntryId     String           @map("home_entry_id")
  homeEntry       TournamentEntry  @relation("TournamentMatchHomeEntry", fields: [homeEntryId], references: [id], onDelete: Cascade)
  awayEntryId     String           @map("away_entry_id")
  awayEntry       TournamentEntry  @relation("TournamentMatchAwayEntry", fields: [awayEntryId], references: [id], onDelete: Cascade)
  sessionId       String?          @unique @map("session_id")
  session         GameSession?     @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  status          String           @default("PENDING")
  homeScore       Int?             @map("home_score")
  awayScore       Int?             @map("away_score")
  homePointsAwarded Float?         @map("home_points_awarded")
  awayPointsAwarded Float?         @map("away_points_awarded")
  winnerEntryId   String?          @map("winner_entry_id")
  tieBreakNeeded  Boolean          @default(false) @map("tie_break_needed")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  @@index([tournamentId, phase, status])
  @@index([roundId, matchIndex])
  @@map("tournament_matches")
}
