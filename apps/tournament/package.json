{
  "name": "dicebudget-tournament",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3022",
    "build": "bash scripts/stamp-build.sh && next build",
    "build:ios": "npm run build && bash scripts/verify-web-export.sh && npx cap sync ios && bash scripts/verify-web-export.sh ios-public && bash scripts/ios-ipad-landscape.sh && find ios/App/App/public -exec touch {} + && bash scripts/open-xcode.sh",
    "open:ios": "bash scripts/open-xcode.sh",
    "cap:sync": "npx cap sync ios",
    "lint": "eslint"
  },
  "dependencies": {
    "@capacitor/app": "^7.1.2",
    "@capacitor/core": "^7.4.2",
    "@capacitor/ios": "^7.4.2",
    "next": "15.5.19",
    "qrcode": "^1.5.4",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.19",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
